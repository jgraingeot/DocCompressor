<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DocCompressor.ViewModels"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="760"
        x:Class="DocCompressor.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Compresseur de documents"
        Width="960" Height="760"
        MinWidth="760" MinHeight="560"
        Background="#F3F4F6">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderBrush" Value="#DDE1E6"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border#DropZone.dragover">
      <Setter Property="BorderBrush" Value="#1F6FD1"/>
      <Setter Property="Background" Value="#EEF4FD"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#6B6B6B"/>
    </Style>
    <Style Selector="TextBlock.columnHeader">
      <Setter Property="Foreground" Value="#6B6B6B"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,24,0"/>
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="24,20">

    <!-- En-tête -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="Compresseur de documents" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Réduit vos photos, scans et PDF pour qu'aucun fichier ne dépasse la taille maximale demandée. Les fichiers d'origine ne sont jamais modifiés."/>
    </StackPanel>

    <!-- Zone de dépôt et liste des fichiers -->
    <Border Grid.Row="1" Name="DropZone" Classes="card" BorderThickness="2"
            DragDrop.AllowDrop="True">
      <Panel>
        <StackPanel IsVisible="{Binding IsEmpty}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="⤓" FontSize="44" Foreground="#9AA4B2" HorizontalAlignment="Center"/>
          <TextBlock Text="Glissez-déposez vos fichiers ici" FontSize="18" FontWeight="SemiBold"
                     HorizontalAlignment="Center"/>
          <TextBlock Classes="muted" Text="Photos et scans (JPG, PNG, WebP, BMP, GIF) ou documents PDF"
                     HorizontalAlignment="Center"/>
          <Button Content="Choisir des fichiers…" HorizontalAlignment="Center" Margin="0,8,0,0"
                  Click="OnAddFilesClick"/>
        </StackPanel>

        <Grid IsVisible="{Binding !IsEmpty}" RowDefinitions="Auto,*">
          <Border Grid.Row="0" Padding="16,10" BorderBrush="#E6E8EB" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,90,90,190,90">
              <TextBlock Classes="columnHeader" Text="{Binding FileCountText}"/>
              <TextBlock Grid.Column="1" Classes="columnHeader" Text="Origine" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="2" Classes="columnHeader" Text="Résultat" HorizontalAlignment="Right"/>
              <TextBlock Grid.Column="3" Classes="columnHeader" Text="État" Margin="20,0,0,0"/>
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Files}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FileItemViewModel">
                  <Border Padding="16,8" BorderBrush="#F0F1F3" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,90,90,190,90">
                      <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}"/>
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Details}"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Details}"
                                   IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding OriginalSizeText}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding ResultSizeText}" FontWeight="SemiBold"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                 FontWeight="SemiBold" Margin="20,0,0,0" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"/>
                      <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"
                                  HorizontalAlignment="Right">
                        <Button Classes="small" Content="Voir" IsVisible="{Binding CanOpenOutput}"
                                ToolTip.Tip="Ouvrir le fichier compressé" Click="OnOpenOutputClick"/>
                        <Button Classes="small" Content="✕" ToolTip.Tip="Retirer de la liste"
                                IsEnabled="{ReflectionBinding $parent[Window].DataContext.IsIdle}"
                                Click="OnRemoveClick"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Panel>
    </Border>

    <!-- Réglages -->
    <Border Grid.Row="2" Classes="card" Padding="16" Margin="0,16,0,0" IsEnabled="{Binding IsIdle}">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Classes="label" Text="Taille maximale par fichier"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <NumericUpDown Value="{Binding MaxSize}" Increment="{Binding SizeIncrement}"
                         Minimum="0" Maximum="100000" FormatString="0.##" Width="140"
                         ClipValueToMinMax="True"/>
          <ComboBox ItemsSource="{Binding Units}" SelectedIndex="{Binding UnitIndex}" Width="80"
                    VerticalAlignment="Center"/>
          <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center"
                     Text="1 Mo = 1 000 000 octets : la limite est aussi respectée si l'organisme compte en Mio."
                     TextWrapping="Wrap" MaxWidth="360"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Classes="label" Text="Images" Margin="0,12,24,0"/>
        <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" IsChecked="{Binding ConvertImagesToPdf}"
                  Content="Convertir les photos et scans en PDF (page A4)"/>

        <TextBlock Grid.Row="2" Classes="label" Text="Enregistrer" Margin="0,18,24,0" VerticalAlignment="Top"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Spacing="4">
          <!-- Pas de GroupName : le gestionnaire de groupe d'Avalonia 11.0 décoche l'autre bouton en écrasant sa liaison.
               L'exclusivité est assurée par le modèle de vue. -->
          <!-- TextBlock explicite : dans un Content texte, « _ » serait pris pour un raccourci clavier -->
          <RadioButton IsChecked="{Binding SaveNextToOriginal}">
            <TextBlock Text="{Binding SaveNextToOriginalText}"/>
          </RadioButton>
          <Grid ColumnDefinitions="Auto,*,Auto">
            <RadioButton IsChecked="{Binding SaveToFolder}" Content="Dans le dossier :"
                         Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding OutputFolder}" Watermark="Choisissez un dossier…"
                     IsEnabled="{Binding SaveToFolder}" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Parcourir…" Margin="8,0,0,0" VerticalAlignment="Center"
                    Click="OnBrowseFolderClick"/>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Actions et progression -->
    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,16,0,0">
      <Button Grid.Column="0" Content="Ajouter des fichiers…" IsEnabled="{Binding IsIdle}"
              Click="OnAddFilesClick"/>
      <Button Grid.Column="1" Content="Vider la liste" Margin="8,0,0,0" IsEnabled="{Binding CanClear}"
              Click="OnClearClick"/>

      <StackPanel Grid.Column="2" Margin="16,0" VerticalAlignment="Center" Spacing="4">
        <TextBlock Text="{Binding ValidationMessage}" Foreground="#DD0000" TextWrapping="Wrap"
                   IsVisible="{Binding HasValidationMessage}"/>
        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding !HasValidationMessage}"/>
        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" ShowProgressText="True"
                     IsVisible="{Binding ShowProgress}"/>
      </StackPanel>

      <Button Grid.Column="3" Content="Ouvrir le dossier" Margin="0,0,8,0" IsEnabled="{Binding HasResults}"
              Click="OnOpenFolderClick"/>
      <Button Grid.Column="4" Classes="accent" Content="{Binding CompressButtonText}" MinWidth="140"
              FontWeight="SemiBold" HorizontalContentAlignment="Center"
              IsEnabled="{Binding CanClickCompress}" Click="OnCompressClick"/>
    </Grid>
  </Grid>
</Window>
